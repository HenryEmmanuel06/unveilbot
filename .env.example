TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO

APP_MODE=PAPER

ENABLE_15S=true
ENABLE_1M=true
ENABLE_5M=true

# Pocket Option is the ONLY live market-data source.
MARKET_DATA_PROVIDER=pocketoption

# Pocket Option session credential (never commit this value).
PO_SSID=

# Optional: force a Pocket Option region, e.g. EUROPE, US_SOUTH, RUSSIA_MOSCOW, DEMO.
# Leave empty to auto-select (demo SSID -> demo region, real SSID -> real regions).
PO_REGION=

DISPLAY_TIMEZONE=Africa/Lagos

# Option expiration durations per analysis timeframe.
# Format: <number><unit> where unit is s, m, or h.
15S_EXPIRATION=1m
30S_EXPIRATION=1m
1M_EXPIRATION=3m
5M_EXPIRATION=10m
15M_EXPIRATION=30m

NOTIFY_INVALIDATIONS=false

# Telegram signal notification switches.
PHASE_1_SIGNAL=true
PHASE_2_SIGNAL=true
PHASE_3_SIGNAL=true

DATABASE_PATH=data/signals.db
